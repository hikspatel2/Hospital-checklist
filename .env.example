# ==============================================================================
# SHETH L.G. GENERAL HOSPITAL, AHMEDABAD
# Multi-Floor Inspection & Complaint Facility Management System
# Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ENVIRONMENT-SPECIFIC CREDENTIALS.
# NEVER COMMIT THE REAL .env FILE TO VERSION CONTROL.

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=true
APP_NAME="Sheth L.G. General Hospital"
APP_SUBTITLE="Multi-Floor Inspection & Complaint Facility Management"
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Security & Encryption Key (Generate a random 32-character hexadecimal or base64 key)
APP_KEY=base64_dGhpcy1pcy1hLXNhbXBsZS1zZWNyZXQta2V5LTMyeHh4eA==

# Session Configuration
SESSION_LIFETIME_MINUTES=60
SESSION_SECURE_COOKIE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Database Credentials (MySQL / MariaDB on Local or Hostinger)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospital_inspection_db
DB_USER=root
DB_PASSWORD=""
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# File Uploads & Storage Paths (Outside public root recommended in production)
UPLOAD_MAX_FILESIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Automated Backups & Disaster Recovery Settings
BACKUP_STORAGE_PATH=storage/backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_KEY=""

# Hospital Location Defaults for Geofence / Attendance (Ahmedabad Coordinates Demo)
DEFAULT_HOSPITAL_LATITUDE=22.9984
DEFAULT_HOSPITAL_LONGITUDE=72.6025
GPS_MAX_ALLOWED_RADIUS_METERS=150
